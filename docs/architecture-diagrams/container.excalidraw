      "link": null,
      "locked": false,
      "text": "Speech Emotion Recognition API\n---------------------------------------------\nREST API, Python (FASTApi)\n\n- Receives audio from frontend\n- Performs feature extraction\n- Calls model for prediction\n- Returns emotion prediction",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "xihGk8rcyNBVfdgOY44Mj",
      "originalText": "Speech Emotion Recognition API\n---------------------------------------------\nREST API, Python (FASTApi)\n\n- Receives audio from frontend\n- Performs feature extraction\n- Calls model for prediction\n- Returns emotion prediction",
      "autoResize": true,
      "lineHeight": 1.25
    },
