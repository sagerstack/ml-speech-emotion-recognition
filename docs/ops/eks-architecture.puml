@startuml
title AWS EKS Deployment (Streamlit + FastAPI)

left to right direction

actor userWeb as "Browser / Streamlit User"
actor userApi as "API Consumer"

node "Public ALB/NLB\nHTTPS 443" as alb

cloud eksControl as "EKS Control Plane\nManaged by AWS"

rectangle "EKS Worker Nodes\n(Private Subnets)" {
    node "Node Group" as nodeGroup {
        rectangle "Streamlit Deployment\n2 pods\nPort 8501" as streamlitPods
        rectangle "FastAPI Backend Deployment\n3 pods\nPort 8000" as fastapiPods
    }
}

database s3 as "S3 Bucket\nTemp audio storage"
rectangle sagemaker as "SageMaker Endpoint"
cloud cloudwatch as "CloudWatch / Prometheus\nHTTP 9090"

userWeb --> alb : "HTTPS/WSS 443"
userApi --> alb : "HTTPS 443"

alb --> streamlitPods : "HTTP 8501"
alb --> fastapiPods : "HTTP 8000"

streamlitPods --> fastapiPods : "REST API\nHTTP 8000"

fastapiPods --> s3 : "S3 SDK\nHTTPS 443"
fastapiPods --> sagemaker : "InvokeEndpoint\nHTTPS 443"
fastapiPods --> cloudwatch : "/metrics\nHTTP 9090"

eksControl -[#gray,dashed]-> streamlitPods : "Scheduling"
eksControl -[#gray,dashed]-> fastapiPods

legend right
    |= Element |= Description |
    |User | Streamlit UI visitor |
    |API Consumer | External system calling backend API |
    |Public ALB/NLB | Terminates HTTPS and routes to services |
    |Streamlit Deployment | Frontend pods (port 8501) |
    |FastAPI Deployment | Backend pods (port 8000) |
    |S3 Bucket | Temporary audio storage |
    |SageMaker Endpoint | Model inference |
    |CloudWatch/Prometheus | Observability / metrics |
endlegend

@enduml
