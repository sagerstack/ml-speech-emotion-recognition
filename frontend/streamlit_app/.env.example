# Streamlit Frontend Configuration
DEBUG=true
STREAMLIT_HOST=localhost
STREAMLIT_PORT=8510

# Backend API Configuration
# URL of the ML backend API service
ML_APP_BASE_URL=http://localhost:8000

# Request Configuration
REQUEST_TIMEOUT=60
MAX_RETRIES=3

# Audio Processing Configuration
MAX_UPLOAD_SIZE_MB=30
SUPPORTED_AUDIO_FORMATS=wav,mp3,flac,m4a

# SageMaker Configuration (matches backend)
SAGEMAKER_ENDPOINT_NAME=speech-emotion-1763484306
AWS_REGION=us-east-1

# Application Settings
APP_TITLE="Speech Emotion Recognition"
APP_LAYOUT="wide"

# Display Settings
SHOW_DEBUG_INFO=true
SHOW_PERFORMANCE_METRICS=true
CONFIDENCE_THRESHOLD=0.5

# History and Analytics
MAX_HISTORY_ITEMS=25
ENABLE_ANALYTICS=false

# Error Handling
SHOW_DETAILED_ERRORS=true
FALLBACK_TO_MOCK=true

# Development Settings
ENABLE_MOCK_MODE=false
# Set to true to use mock inference even when backend is available