{
  "__inputs": [
    {
      "label": "Loki",
      "name": "DS_LOKI",
      "pluginId": "loki",
      "pluginName": "Loki",
      "type": "datasource"
    }
  ],
  "__requires": [
    {
      "id": "grafana",
      "name": "Grafana",
      "type": "grafana",
      "version": "10.0"
    },
    {
      "id": "loki",
      "name": "Loki",
      "type": "datasource",
      "version": "1.0.0"
    },
    {
      "id": "logs",
      "name": "Logs",
      "type": "panel",
      "version": "1.0"
    },
    {
      "id": "timeseries",
      "name": "Time series",
      "type": "panel",
      "version": "1.0"
    }
  ],
  "editable": true,
  "id": 2,
  "panels": [
    {
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "dedupStrategy": "none",
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{namespace=\"$namespace\"}",
          "refId": "A"
        }
      ],
      "title": "All namespace logs",
      "type": "logs"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "id": 2,
      "options": {
        "dedupStrategy": "none",
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{namespace=\"$namespace\",container=\"backend\"}",
          "refId": "A"
        }
      ],
      "title": "Backend logs",
      "type": "logs"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "id": 3,
      "options": {
        "dedupStrategy": "none",
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{namespace=\"$namespace\",container=\"streamlit\"}",
          "refId": "A"
        }
      ],
      "title": "Streamlit logs",
      "type": "logs"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "id": 4,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "expr": "sum by(container) (count_over_time({namespace=\\\"$namespace\\\"}[1m]))",
          "refId": "A"
        }
      ],
      "title": "Log volume by container (1m)",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 38,
  "templating": {
    "list": [
      {
        "current": {
          "text": "ml-speech-emotion",
          "value": "ml-speech-emotion"
        },
        "label": "Namespace",
        "name": "namespace",
        "query": "ml-speech-emotion",
        "type": "textbox"
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "",
  "title": "App Logs",
  "uid": "app-logs-local",
  "version": 1
}
