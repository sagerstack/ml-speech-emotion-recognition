      "targets": [
        {
          "expr": "sum(rate(http_requests_total[5m])) by (method, status_code)",
          "refId": "A",
          "legendFormat": "{{method}} {{status_code}}"
        }
      ],
      "title": "Request Rate (req/sec)",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "displayMode": "list",
        "orientation": "horizontal"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, method, endpoint))",
          "refId": "A",
          "legendFormat": "95th percentile"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, method, endpoint))",
          "refId": "B",
          "legendFormat": "50th percentile"
        }
      ],
      "title": "Response Time (seconds)",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[5m])) by (method, endpoint, status_code)",
          "refId": "A",
          "legendFormat": "{{method}} {{endpoint}} {{status_code}}"
        }
      ],
      "title": "Request Rate by Endpoint",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "id": 4,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(http_request_duration_seconds_sum[5m])) by (method, endpoint) / sum(rate(http_request_duration_seconds_count[5m])) by (method, endpoint)",
          "refId": "A",
          "legendFormat": "Avg {{method}} {{endpoint}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, method, endpoint))",
          "refId": "B",
          "legendFormat": "95th percentile {{method}} {{endpoint}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, method, endpoint))",
          "refId": "C",
          "legendFormat": "99th percentile {{method}} {{endpoint}}"
        }
      ],
      "title": "Response Time Percentiles",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
