# Application Configuration
DEBUG=false
HOST=0.0.0.0
PORT=8000

# AWS Configuration (us-east-1 as specified)
AWS_REGION=us-east-1

# SageMaker Integration Configuration
# Set USE_SAGEMAKER=true for production deployment with SageMaker
# Set USE_SAGEMAKER=false for local development (uses local model files)
USE_SAGEMAKER=false

# SageMaker endpoint name (required when USE_SAGEMAKER=true)
SAGEMAKER_ENDPOINT_NAME=ml-ser-endpoint4

# SageMaker timeout configuration (seconds)
SAGEMAKER_TIMEOUT_SECONDS=30

# SageMaker retry configuration (number of retries for transient errors)
SAGEMAKER_MAX_RETRIES=3

# Security Configuration (JWT)
SECRET_KEY=your-super-secret-key-change-this-in-production
# Generate with: openssl rand -hex 32

# Audio Processing Configuration
MAX_UPLOAD_SIZE_MB=30
MAX_AUDIO_DURATION_SECONDS=30

# S3 Configuration (for temporary audio file storage)
S3_BUCKET_NAME=your-s3-bucket-name
# Optional: Leave empty for local file storage only

# Performance Configuration
MAX_CONCURRENT_REQUESTS=50
REQUEST_TIMEOUT_SECONDS=60

# Monitoring Configuration
PROMETHEUS_ENABLED=true
METRICS_PORT=9090

# Evidently AI Monitoring Configuration
MONITORING_REFERENCE_PATH=monitoring_data/reference_dataset.csv
MONITORING_REPORTS_DIR=monitoring_reports
MONITORING_BUFFER_MAX_RECORDS=500
MONITORING_AUTO_REPORT_THRESHOLD=100
EVIDENTLY_WORKSPACE_PATH=evidently_workspace
EVIDENTLY_PROJECT_NAME=speech_emotion_recognition
EVIDENTLY_DASHBOARD_URL=http://localhost:8080

# CORS Origins (add your frontend URLs here)
# CORS_ORIGINS=http://localhost:3000,http://localhost:8501